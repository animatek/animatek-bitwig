// ATEK303 oscillator display: one cycle of the current wave, as Polymer draws its oscillator.
// Input lanes (from the Nitro core's display output): wave (0 saw, 1 square, 2 triangle),
// shape (pulse width or skew, 0-1), fold (0-1), sync ratio (1-8).
uniform float4 audioLow;

float foldWave(float x) {
    float t = (x + 1.) * .25;
    t = t - floor(t);
    return 1. - 4. * abs(t - .5);
}

float wave(float ph) {
    float w = audioLow.x;
    float sh = clamp(audioLow.y, 0., 1.);
    float fo = clamp(audioLow.z, 0., 1.);
    float r = max(audioLow.w, 1.);
    float s = fract(ph * r);
    float v = 2. * s - 1.;
    if (w > .5 && w < 1.5) {
        v = s < (.05 + .9 * sh) ? 1. : -1.;
    } else if (w >= 1.5) {
        float k = .01 + .98 * sh;
        v = s < k ? -1. + 2. * s / k : 1. - 2. * (s - k) / (1. - k);
    }
    if (fo > 0.) {
        v = foldWave(v * (1. + 4. * fo));
    }
    return v;
}

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution.xy;
    float step = 1. / iResolution.x;
    float a = .5 - .36 * wave(uv.x);
    float b = .5 - .36 * wave(min(uv.x + step, .9999));
    float lo = min(a, b);
    float hi = max(a, b);
    float d = uv.y < lo ? lo - uv.y : (uv.y > hi ? uv.y - hi : 0.);
    float t = 1.6 / iResolution.y;
    float line = 1. - smoothstep(.5 * t, 1.5 * t, d);
    // Animatek amber, over a transparent background.
    half3 amber = half3(.992, .604, 0.);
    return half4(amber * half(line), half(line));
}
