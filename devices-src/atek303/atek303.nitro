component atek303_v2
{
    // ATEK303 for Bitwig: the "Circuit (ATEK)" sound model of the ATEK303 VCV module, on the
    // Open303 engine (Robin Schmidt, MIT), written in Nitro. Mono, last-note priority:
    //   - a note that starts while another is held slides (pitch-domain glide, 120 ms);
    //   - velocity >= 100 (0.787) is an accent; consecutive accents build up (C72 network).
    // Circuit model: ATEK oscillator (ramp core, comparator square with droop), ATEK diode-ladder
    // filter (diode in every cell, C18/C19 = 33/18, input drive x2, linear resonance pot), OTA and
    // output saturation, circuit decay range (T 200 ms - 2.5 s), subtle DAC error and drift.
    // Everything runs in f64; oscillator and filter run 4x oversampled.
    // Bitwig 6.1 Nitro has no tan/tanh/mix/clamp: they are written out below.

    // ---- note state (written by the event handler, applied in process) ----
    i32[16] held;
    i32 held_count = 0;
    i32 request = 0;          // 1 trigger, 2 slide, 3 release, 4 slide back
    i32 request_key = 36;
    i32 request_accent = 0;
    f64 request_vel = 0.8;

    event_inport NoteEvent note_in
    {
        if (note_in.type == note_in.NOTE_ON)
        {
            i32 key = note_in.key;
            remove_key(key);
            if (held_count == 0)
                request = 1;
            else
                request = 2;
            if (held_count < 16)
            {
                held[held_count] = key;
                held_count = held_count + 1;
            }
            request_key = key;
            request_vel = (note_in.v).f64;
            request_accent = 0;
            if (note_in.v >= 0.787)
                request_accent = 1;
        }
        else if (note_in.type == note_in.NOTE_OFF)
        {
            remove_key(note_in.key);
            if (held_count == 0)
            {
                if (request == 0 || request >= 3)
                    request = 3;
            }
            else if (request == 0)
            {
                request = 4;
                request_key = held[held_count - 1];
            }
        }
    }

    audio_inport f32 tuning = 0.5;
    audio_inport f32 cutoff = 0.35;
    audio_inport f32 resonance = 0.5;
    audio_inport f32 env_mod = 0.5;
    audio_inport f32 decay = 0.4;
    audio_inport f32 accent = 0.5;
    audio_inport f32 waveform = 0.0;
    audio_inport f32 volume = 0.5;
    audio_inport f32 phase_knob = 0.0;     // start phase when Retrig is on (0-360 degrees)
    value_inport bool retrig;              // off: free-running VCO, as the hardware
    audio_inport f32 sub_level = 0.0;
    value_inport i32 sub_octave;           // 0: -1 octave, 1: -2 octaves
    value_inport i32 sub_shape;            // 0: sine (as in the FM-1 mod), 1: square
    audio_inport f32 slide_knob = 0.4;     // slide time 40-300 ms (0.4 ~ 120 ms)
    audio_inport f32 vel_amount = 0.0;     // how much note velocity scales the level
    audio_inport f32 pan = 0.5;

    audio_outport out;

    f64 vel_now = 0.8;
    f64 sub_phase = 0.0;

    // ---- engine state ----
    i32 idle = 1;
    f64 key_now = 36.0;
    f64 slew = 0.0;            // log(frequency), slid towards the note
    f64 accent_gain = 0.0;
    f64 main_tau = 400.0;      // ms, set at trigger
    f64 main_env = 0.0;
    f64 rc2 = 0.0;
    i32 amp_on = 0;
    f64 amp_time = 0.0;        // ms since note on
    f64 amp_out = 0.0;
    f64 amp_release = 1.0;     // ms
    f64 accent_fast = 0.0;     // accent accumulators (Q36/C72 and Q38/C62)
    f64 accent_slow = 0.0;

    // drift
    i32 drift_count = 0;
    f64 drift_seed = 0.137;
    f64 drift_pitch = 0.0;
    f64 drift_cut = 0.0;

    // ATEK oscillator (4x)
    f64 phase = 0.0;
    f64 lp_saw = 0.0;
    f64 lp_sq = 0.0;
    f64 hp_saw_x = 0.0;
    f64 hp_saw_y = 0.0;
    f64 hp_sq_x = 0.0;
    f64 hp_sq_y = 0.0;

    // ATEK filter (4x)
    f64 y1 = 0.0;
    f64 y2 = 0.0;
    f64 y3 = 0.0;
    f64 y4 = 0.0;
    f64 fb_prev = 0.0;
    f64 fb_hp = 0.0;
    // one-pole highpass before the filter (4x)
    f64 hp1_x1 = 0.0;
    f64 hp1_y1 = 0.0;
    // anti-alias lowpass before decimation (4x): two biquads
    f64 aa1_x1 = 0.0;
    f64 aa1_x2 = 0.0;
    f64 aa1_y1 = 0.0;
    f64 aa1_y2 = 0.0;
    f64 aa2_x1 = 0.0;
    f64 aa2_x2 = 0.0;
    f64 aa2_y1 = 0.0;
    f64 aa2_y2 = 0.0;
    // after decimation (1x)
    f64 ap_x1 = 0.0;
    f64 ap_y1 = 0.0;
    f64 hp2_x1 = 0.0;
    f64 hp2_y1 = 0.0;
    f64 n_x1 = 0.0;
    f64 n_x2 = 0.0;
    f64 n_y1 = 0.0;
    f64 n_y2 = 0.0;
    f64 dc_x1 = 0.0;
    f64 dc_x2 = 0.0;
    f64 dc_y1 = 0.0;
    f64 dc_y2 = 0.0;

    void remove_key(i32 key)
    {
        i32 j = 0;
        for (i32 i = 0; i < held_count; ++i)
        {
            if (held[i] != key)
            {
                held[j] = held[i];
                j = j + 1;
            }
        }
        held_count = j;
    }

    f64 tan_f(f64 x)
    {
        return sin(x) / cos(x);
    }

    f64 tanh_f(f64 x)
    {
        f64 c = x;
        if (c > 20.0)
            c = 20.0;
        if (c < -20.0)
            c = -20.0;
        f64 e = exp(2.0 * c);
        return (e - 1.0) / (e + 1.0);
    }

    f64 sinh_f(f64 x)
    {
        f64 ex = exp(x);
        return 0.5 * (ex - 1.0 / ex);
    }

    f64 diode(f64 x)
    {
        return 1.2 * tanh_f(x / 1.2);
    }

    f64 poly_blep(f64 t, f64 dt)
    {
        if (t < dt)
        {
            f64 x = t / dt;
            return x + x - x * x - 1.0;
        }
        if (t > 1.0 - dt)
        {
            f64 x = (t - 1.0) / dt;
            return x * x + x + x + 1.0;
        }
        return 0.0;
    }

    f64 fract_f(f64 x)
    {
        return x - floor(x);
    }

    // Deterministic per-note DAC error, -1..1 (each unit detunes its own way, always the same).
    f64 dac_error(f64 note)
    {
        return 2.0 * fract_f(sin(note * 12.9898 + 78.233) * 43758.5453) - 1.0;
    }

    // Uniform -1..1 from a running seed.
    f64 noise_f()
    {
        drift_seed = fract_f(drift_seed * 997.0 + 0.6180339887498949);
        return 2.0 * fract_f(sin(drift_seed * 6283.185307179586) * 43758.5453) - 1.0;
    }

    void reset_voice()
    {
        phase = 0.0;
        sub_phase = 0.0;
        lp_saw = 0.0; lp_sq = 0.0;
        hp_saw_x = 0.0; hp_saw_y = 0.0; hp_sq_x = 0.0; hp_sq_y = 0.0;
        y1 = 0.0; y2 = 0.0; y3 = 0.0; y4 = 0.0;
        fb_prev = 0.0; fb_hp = 0.0;
        hp1_x1 = 0.0; hp1_y1 = 0.0;
        aa1_x1 = 0.0; aa1_x2 = 0.0; aa1_y1 = 0.0; aa1_y2 = 0.0;
        aa2_x1 = 0.0; aa2_x2 = 0.0; aa2_y1 = 0.0; aa2_y2 = 0.0;
        ap_x1 = 0.0; ap_y1 = 0.0;
        hp2_x1 = 0.0; hp2_y1 = 0.0;
        n_x1 = 0.0; n_x2 = 0.0; n_y1 = 0.0; n_y2 = 0.0;
        dc_x1 = 0.0; dc_x2 = 0.0; dc_y1 = 0.0; dc_y2 = 0.0;
    }

    process
    {
        // Read every port once per sample.
        f64 k_tuning = (tuning).f64;
        f64 k_cutoff = (cutoff).f64;
        f64 k_res = (resonance).f64;
        f64 k_env = (env_mod).f64;
        f64 k_decay = (decay).f64;
        f64 k_accent = (accent).f64;
        f64 k_wave = (waveform).f64;
        f64 k_volume = (volume).f64;
        f64 k_phase = fmin(1.0, fmax(0.0, (phase_knob).f64));
        bool k_retrig = retrig;
        f64 k_sub = fmin(1.0, fmax(0.0, (sub_level).f64));
        i32 k_sub_oct = sub_octave;
        i32 k_sub_shape = sub_shape;
        f64 k_slide = fmin(1.0, fmax(0.0, (slide_knob).f64));
        f64 k_vel = fmin(1.0, fmax(0.0, (vel_amount).f64));
        f64 k_pan = fmin(1.0, fmax(0.0, (pan).f64));
        f64 sub_div = 0.5;
        if (k_sub_oct == 1)
            sub_div = 0.25;

        f64 fs = (EC.samplerate).f64;
        f64 fs4 = 4.0 * fs;
        f64 pi = 3.141592653589793;

        // ---- drift: slow random walks, updated every 16 samples (tau 25 s) ----
        drift_count = drift_count + 1;
        if (drift_count >= 16)
        {
            drift_count = 0;
            f64 ddt = 16.0 / fs;
            f64 sq = sqrt(ddt) * 0.25 * 1.7320508075688772;   // uniform with unit variance
            drift_pitch = drift_pitch - drift_pitch * (ddt / 25.0) + noise_f() * sq;
            drift_cut = drift_cut - drift_cut * (ddt / 25.0) + noise_f() * sq;
            drift_pitch = fmin(3.0, fmax(-3.0, drift_pitch));
            drift_cut = fmin(3.0, fmax(-3.0, drift_cut));
        }

        // Knob mappings, as in the ATEK303 VCV module with the Circuit model.
        f64 tune_hz = 400.0 + 80.0 * fmin(1.0, fmax(0.0, k_tuning));
        f64 cutoff_hz = 314.0 * pow(2394.0 / 314.0, fmin(1.0, fmax(0.0, k_cutoff)));
        cutoff_hz = cutoff_hz * (1.0 + drift_cut * 0.015);
        f64 res_lin = fmin(1.0, fmax(0.0, k_res));            // linear pot (VR4, type B)
        f64 e_knob = fmin(1.0, fmax(0.0, k_env));
        f64 env_mod_pct = 100.0 * e_knob * e_knob * e_knob;    // log taper (VR5, type A)
        // Circuit decay range: T 200 ms - 2.5 s (100 % to 10 %), as a time constant.
        f64 tau_min = 86.85889638065036;
        f64 tau_max = 1085.7362047581296;
        f64 decay_ms = tau_min * pow(tau_max / tau_min, fmin(1.0, fmax(0.0, k_decay)));
        f64 accent_knob = fmin(1.0, fmax(0.0, k_accent));
        f64 blend = fmin(1.0, fmax(0.0, k_wave));

        // Accent accumulators discharge.
        accent_fast = accent_fast - accent_fast / (0.10 * fs);
        accent_slow = accent_slow - accent_slow / (0.45 * fs);

        // ---- note requests ----
        if (request != 0)
        {
            i32 r = request;
            request = 0;
            if (r == 1 || r == 2)
            {
                key_now = (request_key).f64;
                vel_now = request_vel;
                if (request_accent == 1)
                {
                    f64 build = 0.5 * accent_fast + 0.5 * accent_slow;
                    accent_gain = fmin(1.0, accent_knob * (1.0 + 0.8 * build));
                    accent_fast = fmin(1.0, accent_fast + 0.55);
                    accent_slow = fmin(1.0, accent_slow + 0.55);
                    main_tau = tau_min;        // accent shorts the pot: minimum decay
                    amp_release = 50.0;
                }
                else
                {
                    accent_gain = 0.0;
                    main_tau = decay_ms;
                    amp_release = 1.0;
                }
            }
            if (r == 1)
            {
                if (idle == 1)
                {
                    reset_voice();
                    idle = 0;
                }
                if (k_retrig)
                {
                    // Phase control: every new (non-slid) note starts the VCO at this phase.
                    phase = k_phase;
                    sub_phase = k_phase * sub_div;
                }
                slew = log(tune_hz) + (key_now - 69.0) / 12.0 * 0.6931471805599453;
                f64 c_main = exp(-1.0 / (0.001 * main_tau * fs));
                main_env = 1.0 / c_main;
                amp_time = 0.0;
                amp_on = 1;
            }
            if (r == 3)
            {
                amp_on = 0;
                amp_time = 1230.0 + 1000.0 / fs;
            }
            if (r == 4)
                key_now = (request_key).f64;
        }

        // ---- pitch: leaky integrator on log(frequency), plus DAC error and drift (cents) ----
        f64 cents = dac_error(key_now) * 1.5 + drift_pitch * 1.5;
        f64 target = log(tune_hz) + (key_now - 69.0 + 0.01 * cents) / 12.0 * 0.6931471805599453;
        f64 slide_ms = 40.0 * pow(7.5, k_slide);   // 40-300 ms; 0.4 is about 120 ms (the module's default)
        f64 c_slide = exp(-1.0 / (fs * 0.001 * slide_ms));
        slew = target + c_slide * (slew - target);
        f64 freq = exp(slew);

        // ---- filter envelope and accent sweep ----
        main_env = main_env * exp(-1.0 / (0.001 * main_tau * fs));
        f64 c_rc2 = exp(-1.0 / (fs * 0.001 * 15.0));
        f64 rc2_in = 0.0;
        if (accent_gain > 0.0)
            rc2_in = main_env;
        rc2 = rc2_in + c_rc2 * (rc2 - rc2_in);

        // Measured env-mod mapping of Open303.
        f64 e = 0.01 * env_mod_pct;
        f64 c = log(cutoff_hz / 313.8152786059267) / 2.032088434607958;
        f64 s_lo = 3.773996325111173 * e + 0.736965594166206;
        f64 s_hi = 4.194548788411135 * e + 0.864344900642434;
        f64 env_scaler = (1.0 - c) * s_lo + c * s_hi;
        f64 env_offset = 0.048292930943553 * c + 0.294391201442418;
        f64 t1 = env_scaler * (main_env - env_offset);
        f64 t2 = accent_gain * rc2;
        f64 inst_cutoff = cutoff_hz * pow(2.0, t1 + t2);

        // ---- amplitude envelope (attack 0, decay 1230 ms, sustain 0) ----
        f64 amp_inc = 1000.0 / fs;
        f64 decay_coeff = 1.0 - exp(-1.0 / (fs * 0.001 * 1230.0));
        if (amp_time <= 0.0)
        {
            amp_out = 1.0;
            amp_time = amp_time + amp_inc;
        }
        else if (amp_time <= 1230.0)
        {
            amp_out = amp_out + decay_coeff * (0.0 - amp_out);
            amp_time = amp_time + amp_inc;
        }
        else if (amp_on == 1)
        {
            amp_out = amp_out + decay_coeff * (0.0 - amp_out);
        }
        else
        {
            f64 release_coeff = 1.0 - exp(-1.0 / (fs * 0.001 * amp_release));
            amp_out = amp_out + release_coeff * (0.0 - amp_out);
            amp_time = amp_time + amp_inc;
        }
        f64 amp = amp_out;
        if (amp_on == 1)
            amp = amp + (0.45 + 4.0 * accent_gain) * main_env;

        // De-clicker: 12 dB lowpass at 200 Hz, Q 0.707.
        {
            f64 w = 2.0 * pi * 200.0 / fs;
            f64 sn = sin(w);
            f64 cs = cos(w);
            f64 alpha = sn / (2.0 * 0.7071067811865476);
            f64 sc = 1.0 / (1.0 + alpha);
            f64 a1 = 2.0 * cs * sc;
            f64 a2 = (alpha - 1.0) * sc;
            f64 b1 = (1.0 - cs) * sc;
            f64 b0 = 0.5 * b1;
            f64 y = b0 * amp + b1 * dc_x1 + b0 * dc_x2 + a1 * dc_y1 + a2 * dc_y2;
            dc_x2 = dc_x1; dc_x1 = amp;
            dc_y2 = dc_y1; dc_y1 = y;
            amp = y;
        }

        // ---- ATEK filter coefficients at the oversampled rate ----
        f64 fc = fmax(10.0, fmin(fmin(inst_cutoff, 14000.0), 0.45 * fs4));
        f64 fx = fc / (fs4 * 1.4142135623730951);
        f64 fb0 = (0.00045522346 + 6.1922189 * fx) / (1.0 + 12.358354 * fx + 4.4156345 * (fx * fx));
        f64 k_scale = fx * (fx * (fx * (fx * (fx * (fx + 7198.6997) - 5837.7917) - 476.47308) + 614.95611) + 213.87126) + 16.998792;
        f64 g_comp = k_scale / 17.0;
        g_comp = (g_comp - 1.0) * res_lin + 1.0;
        g_comp = g_comp * (1.0 + res_lin);
        f64 fk = fmin(k_scale * res_lin, 40.0);
        f64 x_fb = exp(-2.0 * pi * 150.0 / fs4);

        // ---- ATEK oscillator coefficients (4x) ----
        f64 a_lp_saw = 1.0 - exp(-2.0 * pi * fmin(7957.747154594767, 0.45 * fs4) / fs4);   // 20 us reset
        f64 a_lp_sq = 1.0 - exp(-2.0 * pi * fmin(31830.98861837907, 0.45 * fs4) / fs4);   // 5 us slew
        f64 a_hp_saw = exp(-2.0 * pi * 15.0 / fs4);    // saw droop 15 Hz
        f64 a_hp_sq = exp(-2.0 * pi * 60.0 / fs4);     // square droop 60 Hz
        f64 pulse_width = 0.44;

        // Other one-pole coefficients.
        f64 x_hp1 = exp(-2.0 * pi * 44.486 / fs4);
        f64 x_hp2 = exp(-2.0 * pi * 24.167 / fs);
        f64 t_ap = tan_f(pi * 14.008 / fs);
        f64 x_ap = (t_ap - 1.0) / (t_ap + 1.0);

        // Anti-alias: 4th-order Butterworth at 0.45 fs, run at 4 fs.
        f64 w_aa = 2.0 * pi * (0.45 * fs) / fs4;
        f64 sn_aa = sin(w_aa);
        f64 cs_aa = cos(w_aa);
        f64 al1 = sn_aa / (2.0 * 0.5411961001461970);
        f64 al2 = sn_aa / (2.0 * 1.3065629648763766);
        f64 s1 = 1.0 / (1.0 + al1);
        f64 s2 = 1.0 / (1.0 + al2);
        f64 aa1_a1 = 2.0 * cs_aa * s1;
        f64 aa1_a2 = (al1 - 1.0) * s1;
        f64 aa1_b1 = (1.0 - cs_aa) * s1;
        f64 aa1_b0 = 0.5 * aa1_b1;
        f64 aa2_a1 = 2.0 * cs_aa * s2;
        f64 aa2_a2 = (al2 - 1.0) * s2;
        f64 aa2_b1 = (1.0 - cs_aa) * s2;
        f64 aa2_b0 = 0.5 * aa2_b1;

        f64 dt = fmax(0.0, fmin(0.45, freq / fs4));
        f64 sig = 0.0;
        for (i32 i = 0; i < 4; ++i)
        {
            // ATEK oscillator: capacitor ramp and comparator square, polyBLEP edges,
            // rounded reset corner / finite slew, and AC-coupling droop.
            phase = phase + dt;
            if (phase >= 1.0)
                phase = phase - 1.0;
            f64 saw = (2.0 * phase - 1.0) - poly_blep(phase, dt);
            f64 sqv = -1.0;
            if (phase < pulse_width)
                sqv = 1.0;
            sqv = sqv + poly_blep(phase, dt);
            f64 t_fall = phase + (1.0 - pulse_width);
            if (t_fall >= 1.0)
                t_fall = t_fall - 1.0;
            sqv = sqv - poly_blep(t_fall, dt);
            lp_saw = lp_saw + a_lp_saw * (saw - lp_saw);
            lp_sq = lp_sq + a_lp_sq * (sqv - lp_sq);
            hp_saw_y = a_hp_saw * (hp_saw_y + lp_saw - hp_saw_x);
            hp_saw_x = lp_saw;
            hp_sq_y = a_hp_sq * (hp_sq_y + lp_sq - hp_sq_x);
            hp_sq_x = lp_sq;
            // Sub-oscillator: one or two octaves down, locked to the VCO ramp.
            sub_phase = sub_phase + dt * sub_div;
            if (sub_phase >= 1.0)
                sub_phase = sub_phase - 1.0;
            f64 sub = 0.0;
            if (k_sub > 0.0)
            {
                if (k_sub_shape == 1)
                {
                    f64 sdt = dt * sub_div;
                    sub = -1.0;
                    if (sub_phase < 0.5)
                        sub = 1.0;
                    sub = sub + poly_blep(sub_phase, sdt);
                    f64 sf = sub_phase + 0.5;
                    if (sf >= 1.0)
                        sf = sf - 1.0;
                    sub = sub - poly_blep(sf, sdt);
                }
                else
                    sub = sin(2.0 * pi * sub_phase);
            }
            f64 osc = 0.484 * (hp_saw_y + blend * (hp_sq_y - hp_saw_y) + k_sub * sub);
            f64 x = -osc;

            // Pre-filter highpass, 44.5 Hz.
            f64 hp = 0.5 * (1.0 + x_hp1) * (x - hp1_x1) + x_hp1 * hp1_y1;
            hp1_x1 = x;
            hp1_y1 = hp;

            // ATEK diode ladder: a diode in every cell, first cell 33/18 faster, drive x2,
            // feedback through a 150 Hz highpass.
            f64 fb = fk * diode(y4);
            fb_hp = x_fb * (fb_hp + fb - fb_prev);
            fb_prev = fb;
            f64 xin = 2.0 * hp - fb_hp;
            y1 = y1 + 1.8333333333333333 * fb0 * diode(xin - y1 + y2);
            y2 = y2 + fb0 * diode(y1 - 2.0 * y2 + y3);
            y3 = y3 + fb0 * diode(y2 - 2.0 * y3 + y4);
            y4 = y4 + fb0 * diode(y3 - 2.0 * y4);
            f64 filtered = 2.0 * g_comp * y4;

            // Anti-alias lowpass.
            f64 a = aa1_b0 * filtered + aa1_b1 * aa1_x1 + aa1_b0 * aa1_x2 + aa1_a1 * aa1_y1 + aa1_a2 * aa1_y2;
            aa1_x2 = aa1_x1; aa1_x1 = filtered;
            aa1_y2 = aa1_y1; aa1_y1 = a;
            f64 b = aa2_b0 * a + aa2_b1 * aa2_x1 + aa2_b0 * aa2_x2 + aa2_a1 * aa2_y1 + aa2_a2 * aa2_y2;
            aa2_x2 = aa2_x1; aa2_x1 = a;
            aa2_y2 = aa2_y1; aa2_y1 = b;
            sig = b;
        }

        // Allpass 14 Hz, highpass 24 Hz.
        f64 ap = x_ap * sig + ap_x1 - x_ap * ap_y1;
        ap_x1 = sig;
        ap_y1 = ap;
        f64 hp2 = 0.5 * (1.0 + x_hp2) * (ap - hp2_x1) + x_hp2 * hp2_y1;
        hp2_x1 = ap;
        hp2_y1 = hp2;

        // Band-reject at 7.5 Hz, 4.7 octaves wide.
        f64 nw = 2.0 * pi * 7.5164 / fs;
        f64 nsn = sin(nw);
        f64 ncs = cos(nw);
        f64 nal = nsn * sinh_f(0.5 * 0.6931471805599453 * 4.7 * nw / nsn);
        f64 nsc = 1.0 / (1.0 + nal);
        f64 n_a1 = 2.0 * ncs * nsc;
        f64 n_a2 = (nal - 1.0) * nsc;
        f64 n_b0 = nsc;
        f64 n_b1 = -2.0 * ncs * nsc;
        f64 notch = n_b0 * hp2 + n_b1 * n_x1 + n_b0 * n_x2 + n_a1 * n_y1 + n_a2 * n_y2;
        n_x2 = n_x1; n_x1 = hp2;
        n_y2 = n_y1; n_y1 = notch;

        // OTA BA662A headroom (soft), the VCA, engine level -6 dB.
        f64 ota = 0.6 * tanh_f(notch / 0.6);
        f64 core = ota * amp * 0.5011872336272722;

        // Output stage saturation (strong), on the 5 V scale of the VCV module.
        f64 volts = 5.0 * core;
        volts = 4.5 * tanh_f(volts / 4.5);
        f64 vel_gain = 1.0 - k_vel + k_vel * vel_now;
        f64 result = 0.2 * volts * 2.0 * k_volume * vel_gain;
        // Equal-power pan.
        f64 pan_angle = 0.5 * pi * k_pan;
        f64 left = result * cos(pan_angle) * 1.4142135623730951;
        f64 right = result * sin(pan_angle) * 1.4142135623730951;
        f32<> o = 0.0;
        o[0] = (left).f32;
        o[1] = (right).f32;
        out = o;
    }
}
